---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { adminConfigured, verifyAdminCookie } from "../../../lib/admin-auth";
import { getPhotos } from "../../../lib/photos";

const authenticated = Boolean(verifyAdminCookie(Astro.cookies.get("photo_admin")?.value));
const published = Astro.url.searchParams.get("published") === "1";
const error = Astro.url.searchParams.get("error");
const photos = authenticated ? await getPhotos() : [];
---

<BaseLayout pageTitle="Photo Admin" description="Private photo publishing tools.">
  {!adminConfigured() ? (
    <p class="notice error">Set <code>ATPROTO_ADMIN_DID</code> and <code>ADMIN_SESSION_SECRET</code> to enable this page.</p>
  ) : !authenticated ? (
    <form method="post" action="/admin/photos/login" class="panel">
      <label for="handle">AT Protocol handle</label>
      <input id="handle" name="handle" autocomplete="username" required />
      <button type="submit">Sign in with AT Protocol</button>
    </form>
  ) : (
    <>
      {published && <p class="notice success">Photo published successfully.</p>}
      {error && <p class="notice error">{error}</p>}
      <form id="publish-form" method="post" action="/admin/photos/publish" enctype="multipart/form-data" class="panel">
        <label for="photo">Photo</label>
        <input id="photo" name="photo" type="file" accept="image/*" required />
        <img id="preview" alt="Selected photo preview" hidden />

        <label for="alt">Alt text <span>(required)</span></label>
        <textarea id="alt" name="alt" rows="3" required></textarea>

        <label for="caption">Caption / social post text</label>
        <textarea id="caption" name="caption" rows="5" maxlength="2200"></textarea>
        <small>Bluesky limits captions to 300 characters.</small>

        <label for="takenAt">Date taken</label>
        <input id="takenAt" name="takenAt" type="datetime-local" />

        <fieldset>
          <legend>Also publish to</legend>
          <label><input type="checkbox" name="bluesky" /> Bluesky</label>
          <label><input type="checkbox" name="instagram" /> Instagram</label>
        </fieldset>

        <button type="submit">Publish photo</button>
        <p id="publish-status" role="status" hidden></p>
      </form>
      <form method="post" action="/admin/photos/logout" class="logout">
        <button type="submit">Sign out</button>
      </form>
      <section class="existing">
        <h2>Published photos</h2>
        <p><a href="/photos/">Open the public photo feed</a></p>
        {photos.length === 0 ? <p>No photos are available in this build yet.</p> : (
          <div class="photo-grid">
            {photos.map((photo) => (
              <figure>
                <img src={photo.data.imageUrl} alt={photo.data.alt} loading="lazy" />
                {photo.data.caption && <figcaption>{photo.data.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}
      </section>
      <script>
        const input = document.querySelector<HTMLInputElement>("#photo");
        const preview = document.querySelector<HTMLImageElement>("#preview");
        const form = document.querySelector<HTMLFormElement>("#publish-form");
        const status = document.querySelector<HTMLParagraphElement>("#publish-status");
        input?.addEventListener("change", () => {
          const file = input.files?.[0];
          if (!file || !preview) return;
          preview.src = URL.createObjectURL(file);
          preview.hidden = false;
        });

        const compressPhoto = async (file: File) => {
          const bitmap = await createImageBitmap(file, { imageOrientation: "from-image" });
          const scale = Math.min(1, 2000 / bitmap.width, 2000 / bitmap.height);
          const canvas = document.createElement("canvas");
          canvas.width = Math.round(bitmap.width * scale);
          canvas.height = Math.round(bitmap.height * scale);
          canvas.getContext("2d")?.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
          bitmap.close();
          const blob = await new Promise<Blob>((resolve, reject) =>
            canvas.toBlob(
              (result) => result ? resolve(result) : reject(new Error("Unable to prepare this image.")),
              "image/jpeg",
              0.85
            )
          );
          if (blob.size > 3_500_000) throw new Error("The prepared image is still too large to upload.");
          const name = file.name.replace(/\.[^.]+$/, "") + ".jpg";
          return new File([blob], name, { type: "image/jpeg" });
        };

        form?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const file = input?.files?.[0];
          if (!file || !status) return;
          const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
          button?.setAttribute("disabled", "");
          status.hidden = false;
          status.textContent = "Preparing photo…";
          try {
            const body = new FormData(form);
            body.set("photo", await compressPhoto(file));
            status.textContent = "Publishing to the PDS and selected networks…";
            const response = await fetch(form.action, { method: "POST", body });
            if (!response.ok) throw new Error(await response.text() || `Publishing failed (${response.status}).`);
            window.location.assign(response.url);
          } catch (error) {
            status.textContent = error instanceof Error ? error.message : "Publishing failed.";
            button?.removeAttribute("disabled");
          }
        });
      </script>
    </>
  )}
</BaseLayout>

<style>
  .panel { display: grid; gap: 0.75rem; max-width: 36rem; padding: 1rem; background: var(--surface-bg); border: 2px solid var(--page-fg); }
  label, legend, button { font-family: var(--font-sans), sans-serif; font-weight: 700; }
  label span { font-weight: 400; }
  input, textarea, button { font: inherit; padding: 0.55rem; }
  textarea { resize: vertical; }
  fieldset { display: flex; gap: 1.25rem; }
  #preview { max-height: 24rem; object-fit: contain; background: var(--border-color); }
  button { width: fit-content; cursor: pointer; }
  .notice { padding: 0.7rem; border: 2px solid; }
  .success { background: var(--aquamarine); }
  .error { background: #ffd5d5; }
  .logout { margin-top: 1.5rem; }
  .existing { margin-top: 2rem; }
  .photo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1rem; }
  figure { margin: 0; }
  figure img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; }
  figcaption { font-size: 0.85rem; margin-top: 0.3rem; }
</style>
